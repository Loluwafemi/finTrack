EXPO_OFFLINE=1
NODE_ENV=test

# switch to environment
EXPO_NO_DOTENV=0

# used to access the backend gracefully
EXPO_PUBLIC_BACKEND_ORIGINS = "http://127.0.0.1:8080"


# as a key for the cookie
EXPO_PUBLIC_ORIGIN = "127.0.0.1"



# must match all other services
EXPO_PUBLIC_API_AUTHORIZATION = "Bearer"


# define the app personal address: can be static or virtual: CHANGE THIS BEFORE DEPLOYING AND MAKE SURE THE BACKEND HAS IT ON LIST OF ALLOWED
EXPO_PUBLIC_HOST_ADDR = "http://127.0.0.1:8085"

# NOTE: 8085 for admin